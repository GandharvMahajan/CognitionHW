generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  APPROVER
  REVIEWER
  AUDITOR
}

enum KycStatus {
  NEW
  ASSIGNED
  IN_REVIEW
  PENDING_INFO
  ESCALATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RefundStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
  RECONCILED
  CANCELLED
}

enum RefundKind {
  FULL
  PARTIAL
}

enum FlagEnvironment {
  development
  staging
  production
}

enum FlagChangeKind {
  TOGGLE
  ROLLOUT
  SCHEDULE
  ROLLBACK
  KILL_SWITCH
}

enum FlagChangeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  APPLIED
  CANCELLED
}

enum EntityType {
  KYC_CASE
  REFUND
  FEATURE_FLAG
  FLAG_CHANGE
  USER
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roles        Role[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases     KycCase[]      @relation("caseAssignee")
  decidedCases      KycCase[]      @relation("caseDecider")
  requestedRefunds  Refund[]       @relation("refundRequester")
  approvedRefunds   Refund[]       @relation("refundApprover")
  requestedChanges  FlagChange[]   @relation("changeRequester")
  approvedChanges   FlagChange[]   @relation("changeApprover")
  comments          Comment[]
  auditEvents       AuditEvent[]
  notifications     Notification[]

  @@index([email])
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  country     String
  dateOfBirth DateTime
  riskScore   Int      @default(0)
  createdAt   DateTime @default(now())

  cases        KycCase[]
  transactions Transaction[]
  refunds      Refund[]

  @@index([fullName])
}

model KycCase {
  id             String    @id @default(cuid())
  reference      String    @unique
  customerId     String
  status         KycStatus @default(NEW)
  riskLevel      RiskLevel
  riskScore      Int
  assigneeId     String?
  slaDueAt       DateTime
  version        Int       @default(0)
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("caseAssignee", fields: [assigneeId], references: [id])
  decidedBy    User?            @relation("caseDecider", fields: [decidedById], references: [id])
  documents    KycDocument[]
  infoRequests KycInfoRequest[]

  @@index([status])
  @@index([riskLevel])
  @@index([assigneeId])
  @@index([slaDueAt])
}

model KycDocument {
  id           String         @id @default(cuid())
  caseId       String
  type         String
  fileName     String
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  case KycCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model KycInfoRequest {
  id                 String    @id @default(cuid())
  caseId             String
  requestedDocuments String[]
  reason             String
  requestedById      String
  fulfilledAt        DateTime?
  createdAt          DateTime  @default(now())

  case KycCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Transaction {
  id            String   @id @default(cuid())
  reference     String   @unique
  customerId    String
  amountMinor   Int
  currency      String   @default("USD")
  settled       Boolean  @default(true)
  paymentMethod String
  description   String
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refunds  Refund[]

  @@index([customerId])
}

model Refund {
  id                String       @id @default(cuid())
  reference         String       @unique
  transactionId     String
  customerId        String
  amountMinor       Int
  currency          String       @default("USD")
  kind              RefundKind
  status            RefundStatus @default(REQUESTED)
  reason            String
  idempotencyKey    String       @unique
  requestedById     String
  approvedById      String?
  decisionReason    String?
  attempts          Int          @default(0)
  lastError         String?
  providerReference String?
  reconciledAt      DateTime?
  executedAt        DateTime?
  version           Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("refundRequester", fields: [requestedById], references: [id])
  approvedBy  User?           @relation("refundApprover", fields: [approvedById], references: [id])
  attemptLog  RefundAttempt[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model RefundAttempt {
  id                String   @id @default(cuid())
  refundId          String
  attemptNumber     Int
  succeeded         Boolean
  providerReference String?
  error             String?
  createdAt         DateTime @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, attemptNumber])
  @@index([refundId])
}

model FeatureFlag {
  id                String          @id @default(cuid())
  key               String
  service           String
  environment       FlagEnvironment
  description       String
  enabled           Boolean         @default(false)
  rolloutPercentage Int             @default(0)
  killSwitchEngaged Boolean         @default(false)
  version           Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  changes FlagChange[]

  @@unique([key, environment])
  @@index([service])
  @@index([environment])
}

model FlagChange {
  id              String           @id @default(cuid())
  flagId          String
  kind            FlagChangeKind
  status          FlagChangeStatus @default(DRAFT)
  reason          String
  beforeState     Json
  afterState      Json
  expectedVersion Int
  requestedById   String
  approvedById    String?
  decisionReason  String?
  scheduledFor    DateTime?
  appliedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  flag        FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("changeRequester", fields: [requestedById], references: [id])
  approvedBy  User?       @relation("changeApprover", fields: [approvedById], references: [id])

  @@index([flagId])
  @@index([status])
}

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  authorId   String
  body       String
  createdAt  DateTime   @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId])
}

/// Append-only. A database trigger blocks UPDATE and DELETE on this table.
model AuditEvent {
  id         String     @id @default(cuid())
  action     String
  entityType EntityType
  entityId   String
  actorId    String?
  summary    String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime   @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id         String     @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  entityType EntityType
  entityId   String
  readAt     DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  runAt     DateTime  @default(now())
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}
